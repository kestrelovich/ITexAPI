{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=itex.db"
  },
  "Jwt": {
    "Key": "your-production-jwt-key-here-minimum-32-characters-for-security",
    "Issuer": "ITex",
    "Audience": "ITex-Client",
    "ExpirationMinutes": 1440
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/itex-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}